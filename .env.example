# Copy to .env and fill in. .env is gitignored.

# Postgres connection (matches docker-compose.yml)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fraud_db

# Admin role used by db/migrate.py (the compose superuser)
ADMIN_USER=fraud_user
ADMIN_PASSWORD=fraud_pass

# Passwords for the roles created by db/migrations/0002_roles.sql.
# A role whose password is unset stays NOLOGIN.
PIPELINE_WRITER_PASSWORD=
WORKER_PASSWORD=
AGENT_RO_PASSWORD=

# investigation_enqueuer.py (PLAN.md D2)
ENQUEUE_SETTLE=5 minutes
ENQUEUE_GRACE=30 minutes
# Flags before this are ignored: the July 2026 flags are 8 h misaligned (docs/CURRENT_STATE.md G12)
ENQUEUE_SINCE=2026-10-18T00:00:00Z
ENQUEUE_POLL_SECONDS=30

# Agent
GEMINI_API_KEY=
MODEL_PROVIDER=gemini
# investigation_worker.py (PLAN.md Phase 3)
# Kill switch: set false to stop new claims; re-read from this file every loop.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# Max investigation attempts started per rolling hour. Set from measured cost (PLAN.md risks).
WORKER_HOURLY_BUDGET=20
WORKER_TIMEOUT_SECONDS=180
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=30
WORKER_STUCK_AFTER_SECONDS=600
WORKER_POLL_SECONDS=5

# routing.py (docs/PLAN_HITL.md H3); these are the defaults
# Data is in USD; 2500 is about AED 9,200
REVIEW_AMOUNT_LIMIT_USD=2500
# Uncertain risk_score band, inclusive
REVIEW_UNCERTAIN_MIN=30
REVIEW_UNCERTAIN_MAX=70
# Share of auto-cleared cases queued for QA, deterministic from the id (0.10: id % 10 == 0)
REVIEW_QA_SAMPLE_RATE=0.10
# Accounts younger than this many days are reviewed (a proxy for "pattern looks new")
REVIEW_NEW_ACCOUNT_DAYS=30

# Ollama (agent/adapters/ollama_adapter.py); used when MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
OLLAMA_TIMEOUT_SECONDS=120
